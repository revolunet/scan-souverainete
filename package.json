{
  "name": "scan-souverainete",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "report": "node dist/report.js",
    "clean": "node dist/clean.js",
    "dev": "node --loader ts-node/esm src/index.ts",
    "geoip": "mkdir -p output/geoip && curl -L -o output/geoip/GeoLite2-Country.mmdb https://github.com/P3TERX/GeoLite.mmdb/releases/latest/download/GeoLite2-Country.mmdb"
  },
  "dependencies": {
    "puppeteer": "^25.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "puppeteer@24.43.1": true
  }
}
